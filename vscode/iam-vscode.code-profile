{"name":"iam-vscode","settings":"{\"settings\":\"{\\n    // \\\"[python]\\\": {\\n    //     \\\"editor.formatOnSave\\\": true,\\n    //     \\\"editor.formatOnSaveMode\\\": \\\"modificationsIfAvailable\\\",\\n    //     \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n    //     \\\"editor.codeActionsOnSave\\\": {\\\"source.organizeImports\\\": \\\"explicit\\\"},\\n    //     \\\"diffEditor.ignoreTrimWhitespace\\\": false\\n    // },\\n    \\\"notebook.formatOnSave.enabled\\\": true,\\n    \\\"editor.rulers\\\": [\\n        100\\n    ],\\n    \\\"editor.occurrencesHighlight\\\": \\\"off\\\",\\n    \\\"editor.selectionHighlight\\\": false,\\n    \\\"workbench.colorCustomizations\\\": {\\n        \\\"editorRuler.foreground\\\": \\\"#353535aa\\\"\\n    },\\n    \\\"python.analysis.extraPaths\\\": [],\\n\\n    \\\"workbench.editor.labelFormat\\\": \\\"short\\\",\\n    \\\"diffEditor.experimental.useTrueInlineView\\\": true,\\n\\n    \\\"editor.fontFamily\\\": \\\"'Monaspace Argon SemiWide', monospace\\\",\\n    \\\"editor.fontWeight\\\": 300,\\n    // Font ligatures & modifications\\n    // cv10 => Alternate i / l\\n    // cv30 => Vertical align *\\n    // cv02 => Alternate 1\\n    \\\"editor.fontLigatures\\\": \\\"'calt', 'cv30', 'cv02'\\\",\\n    \\\"editor.inlineSuggest.fontFamily\\\": \\\"'Monaspace Krypton', monospace\\\",\\n\\n    \\\"editor.guides.indentation\\\": true,\\n    \\n    // font sizing info\\n    \\\"window.zoomLevel\\\": 2,\\n    \\\"editor.fontSize\\\": 14, \\n\\n    // presentation mode\\n    // \\\"window.zoomLevel\\\": 4,\\n    // \\\"editor.fontSize\\\": 10, \\n\\n    \\\"terminal.integrated.fontSize\\\": 9,\\n\\n    \\\"editor.minimap.renderCharacters\\\": false,\\n    \\\"editor.minimap.enabled\\\": false,\\n    \\\"editor.scrollBeyondLastLine\\\": false,\\n    \\\"editor.lineNumbers\\\": \\\"relative\\\",\\n    \\\"workbench.editor.showTabs\\\": \\\"multiple\\\",\\n    \\\"workbench.editor.tabSizing\\\": \\\"fixed\\\",\\n\\n    \\\"explorer.compactFolders\\\": false,\\n    \\\"editor.minimap.showSlider\\\": \\\"always\\\",\\n    \\\"terminal.integrated.lineHeight\\\": 0,\\n\\n    // .ipynb settings\\n    \\\"notebook.lineNumbers\\\": \\\"on\\\",\\n    \\\"notebook.output.fontSize\\\": 8,\\n    \\\"notebook.diff.overviewRuler\\\": true,\\n    // \\\"debug.console.lineHeight\\\": 1, // using this value breaks the Databricks extension return value from cell runs\\n\\n    \\\"workbench.tree.indent\\\": 30,\\n\\n    // Vim configurations\\n    \\\"vim.leader\\\": \\\"<space>\\\",\\n    \\\"vim.normalModeKeyBindingsNonRecursive\\\": [\\n        {\\n            \\\"before\\\": [\\\"<C-d>\\\"],\\n            \\\"after\\\": [\\\"<C-d>\\\", \\\"z\\\", \\\"z\\\"]\\n        },\\n        {\\n            \\\"before\\\": [\\\"<C-u>\\\"],\\n            \\\"after\\\": [\\\"<C-u>\\\", \\\"z\\\", \\\"z\\\"]\\n        },\\n        {\\n            \\\"before\\\": [\\\"n\\\"],\\n            \\\"after\\\": [\\\"n\\\", \\\"z\\\", \\\"z\\\"]\\n        },\\n        {\\n            \\\"before\\\": [\\\"N\\\"],\\n            \\\"after\\\": [\\\"N\\\", \\\"z\\\", \\\"z\\\"]\\n        },\\n        // Wrap current word in quotes\\n        {\\n            \\\"before\\\": [\\\"<leader>\\\", \\\"w\\\"],\\n            \\\"after\\\": [\\\"c\\\", \\\"i\\\", \\\"w\\\", \\\"\\\\\\\"\\\", \\\"C-r\\\", \\\"\\\\\\\"\\\", \\\"\\\\\\\"\\\", \\\"<Esc>\\\"]\\n        },\\n        // Wrap current word in 'CAST(... AS STRING)'\\n        {\\n            \\\"before\\\": [\\\"<leader>\\\", \\\"c\\\"],\\n            \\\"after\\\": [\\\"c\\\", \\\"i\\\", \\\"w\\\", \\\"C\\\", \\\"A\\\", \\\"S\\\", \\\"T\\\", \\\"(\\\", \\\"C-r\\\", \\\"\\\\\\\"\\\", \\\" \\\", \\\"A\\\", \\\"S\\\", \\\" \\\", \\\"S\\\", \\\"T\\\", \\\"R\\\", \\\"I\\\", \\\"N\\\", \\\"G\\\", \\\")\\\", \\\"<Esc>\\\"]\\n        },\\n    ],\\n    \\\"vim.visualModeKeyBindings\\\": [\\n        {\\n            \\\"before\\\": [\\\"p\\\"],\\n            \\\"after\\\": [\\\"P\\\"]\\n        },\\n        {\\n            \\\"before\\\": [\\\"<C-d>\\\"],\\n            \\\"after\\\": [\\\"<C-d>\\\", \\\"z\\\", \\\"z\\\"]\\n        },\\n        {\\n            \\\"before\\\": [\\\"<C-u>\\\"],\\n            \\\"after\\\": [\\\"<C-u>\\\", \\\"z\\\", \\\"z\\\"]\\n        },\\n    ],\\n    \\\"vim.handleKeys\\\": {\\n        \\\"<C-d>\\\": true,\\n        \\\"<C-s>\\\": true,\\n        \\\"<C-z>\\\": true,\\n        \\\"<C-e>\\\": false,\\n    },\\n    \\\"extensions.experimental.affinity\\\": {\\n        \\\"vscodevim.vim\\\": 1\\n    },\\n    // \\\"gitlens.codeLens.enabled\\\": false,\\n    // \\\"gitlens.hovers.enabled\\\": false,\\n    // \\\"gitlens.heatmap.locations\\\": [\\n    //     \\\"overview\\\"\\n    // ],\\n    // \\\"gitlens.heatmap.fadeLines\\\": false,\\n    \\\"workbench.editorAssociations\\\": {\\n        \\\"git-rebase-todo\\\": \\\"default\\\"\\n    },\\n    \\\"python.analysis.typeCheckingMode\\\": \\\"basic\\\",\\n    \\\"python.analysis.diagnosticSeverityOverrides\\\": {\\n        \\\"reportUnknownVariableType\\\": \\\"none\\\",\\n        \\\"reportUnknownArgumentType\\\": \\\"none\\\",\\n        \\\"reportUnknownParameterType\\\": \\\"none\\\",\\n        \\\"reportUnknownMemberType\\\": \\\"none\\\",\\n        \\\"reportUnknownLambdaType\\\": \\\"none\\\",\\n        \\\"reportMissingTypeStubs\\\": \\\"none\\\",\\n    },\\n    \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n    \\\"jupyter.askForKernelRestart\\\": false,\\n    // \\\"vim.highlightedyank.enable\\\": true,\\n    // \\\"vim.highlightedyank.color\\\": \\\"rgba(210, 210, 210, 0.3)\\\",\\n    // \\\"vim.highlightedyank.color\\\": \\\"rgba(250, 240, 170, 0.075)\\\",\\n    // \\\"vim.highlightedyank.duration\\\": 100,\\n    \\\"explorer.copyRelativePathSeparator\\\": \\\"/\\\",\\n    \\\"vim.smartRelativeLine\\\": true,\\n    \\\"terminal.integrated.cursorBlinking\\\": true,\\n    \\\"window.title\\\": \\\"${dirty}${rootName}${separator}${activeEditorMedium}\\\",\\n    \\\"workbench.editor.wrapTabs\\\": false,\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    // \\\"editor.autoClosingBrackets\\\": \\\"never\\\"\\n    \\\"window.newWindowDimensions\\\": \\\"maximized\\\",\\n    \\\"diffEditor.ignoreTrimWhitespace\\\": true,\\n    \\\"diffEditor.renderSideBySide\\\": true,\\n    \\\"diffEditor.experimental.showMoves\\\": true,\\n    \\\"diffEditor.useInlineViewWhenSpaceIsLimited\\\": false,\\n    // \\\"gitlens.currentLine.enabled\\\": false,\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"editor.overviewRulerBorder\\\": false,\\n    \\\"notebook.outline.showCodeCellSymbols\\\": false,\\n    \\\"notebook.outline.showMarkdownHeadersOnly\\\": false,\\n    \\\"notebook.scrolling.revealNextCellOnExecute\\\": \\\"none\\\",\\n    \\\"jupyter.interactiveWindow.cellMarker.decorateCells\\\": \\\"None\\\",\\n\\n    // disable databricks running\\n    \\\"editor.renderLineHighlight\\\": \\\"none\\\",\\n    \\\"jupyter.interactiveWindow.codeLens.enable\\\": false,\\n    \\\"editor.detectIndentation\\\": false,\\n    \\\"workbench.editor.doubleClickTabToToggleEditorGroupSizes\\\": \\\"off\\\",\\n    \\\"editor.guides.highlightActiveIndentation\\\": false,\\n\\n    \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n    \\\"window.enableMenuBarMnemonics\\\": false,\\n    \\\"window.customMenuBarAltFocus\\\": false,\\n    \\\"chat.commandCenter.enabled\\\": false,\\n    \\\"editor.renderWhitespace\\\": \\\"none\\\",\\n    \\\"workbench.editor.centeredLayoutAutoResize\\\": false,\\n    \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n    \\\"workbench.navigationControl.enabled\\\": false,\\n    \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n    \\\"editor.lightbulb.enabled\\\": \\\"off\\\",\\n    \\\"breadcrumbs.enabled\\\": false,\\n    \\\"editor.cursorBlinking\\\": \\\"solid\\\",\\n    \\\"workbench.editor.tabSizingFixedMaxWidth\\\": 160,\\n    \\\"workbench.editor.tabSizingFixedMinWidth\\\": 160,\\n    \\\"terminal.integrated.tabs.defaultColor\\\": \\\"terminal.ansiBlack\\\",\\n    \\\"editor.stickyScroll.enabled\\\": false,\\n    \\\"workbench.editor.limit.value\\\": 5,\\n    \\\"workbench.editor.limit.perEditorGroup\\\": true,\\n    \\\"workbench.editor.limit.enabled\\\": true,\\n    \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n    \\\"workbench.externalBrowser\\\": \\\"edge\\\",\\n    \\\"workbench.editor.autoLockGroups\\\": {\\n        \\\"workbench.editor.chatSession\\\": false\\n    },\\n    \\\"editor.inlayHints.fontFamily\\\": \\\"'Monaspace Krypton', monospace\\\",\\n    \\\"debug.console.fontFamily\\\": \\\"'Monaspace Krypton', monospace\\\",\\n    \\\"terminal.integrated.fontFamily\\\": \\\"'Monaspace Krypton', monospace\\\",\\n    \\\"notebook.markup.fontFamily\\\": \\\"'Monaspace Argon', monospace\\\",\\n    \\\"window.commandCenter\\\": false,\\n    \\\"editor.hover.sticky\\\": false,\\n    \\\"editor.stickyScroll.scrollWithEditor\\\": false,\\n    \\\"workbench.tree.enableStickyScroll\\\": false,\\n    \\\"workbench.activityBar.location\\\": \\\"bottom\\\",\\n    \\\"window.menuBarVisibility\\\": \\\"compact\\\",\\n    \\\"workbench.layoutControl.enabled\\\": false,\\n    \\\"workbench.editor.pinnedTabSizing\\\": \\\"compact\\\",\\n    \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n    \\\"window.density.editorTabHeight\\\": \\\"compact\\\",\\n    \\\"[dockercompose]\\\": {\\n        \\\"editor.insertSpaces\\\": true,\\n        \\\"editor.tabSize\\\": 2,\\n        \\\"editor.autoIndent\\\": \\\"advanced\\\",\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n    },\\n    \\\"[github-actions-workflow]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n    },\\n    \\\"scm.repositories.selectionMode\\\": \\\"single\\\",\\n    \\\"workbench.colorTheme\\\": \\\"Dark Modern\\\",\\n}\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n// [\\n//     {\\n//         \\\"key\\\": \\\"ctrl+d\\\",\\n//         \\\"command\\\": \\\"-vscode-neovim.ctrl-d\\\",\\n//         \\\"when\\\": \\\"editorTextFocus && neovim.ctrlKeysNormal && neovim.init && neovim.mode != 'insert'\\\"\\n//     },\\n//     {\\n//         \\\"key\\\": \\\"ctrl+u\\\",\\n//         \\\"command\\\": \\\"-vscode-neovim.ctrl-u\\\",\\n//         \\\"when\\\": \\\"editorTextFocus && neovim.ctrlKeysNormal && neovim.init && neovim.mode != 'insert'\\\"\\n//     },\\n// ]\\n[\\n    {\\n        \\\"key\\\": \\\"pageup\\\",\\n        \\\"command\\\": \\\"-notebook.cell.cursorPageUp\\\",\\n        \\\"when\\\": \\\"editorTextFocus && inputFocus && notebookEditorFocused\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pageup\\\",\\n        \\\"command\\\": \\\"-editor.action.pageUpHover\\\",\\n        \\\"when\\\": \\\"editorHoverFocused\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pageup\\\",\\n        \\\"command\\\": \\\"-cursorPageUp\\\",\\n        \\\"when\\\": \\\"textInputFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pageup\\\",\\n        \\\"command\\\": \\\"-list.focusPageUp\\\",\\n        \\\"when\\\": \\\"listFocus && !inputFocus && !treestickyScrollFocused\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pagedown\\\",\\n        \\\"command\\\": \\\"-notebook.cell.cursorPageDown\\\",\\n        \\\"when\\\": \\\"editorTextFocus && inputFocus && notebookEditorFocused\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pagedown\\\",\\n        \\\"command\\\": \\\"-editor.action.pageDownHover\\\",\\n        \\\"when\\\": \\\"editorHoverFocused\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pagedown\\\",\\n        \\\"command\\\": \\\"-cursorPageDown\\\",\\n        \\\"when\\\": \\\"textInputFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pagedown\\\",\\n        \\\"command\\\": \\\"-list.focusPageDown\\\",\\n        \\\"when\\\": \\\"listFocus && !inputFocus && !treestickyScrollFocused\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"pagedown\\\",\\n        \\\"command\\\": \\\"-workbench.action.interactivePlayground.pageDown\\\",\\n        \\\"when\\\": \\\"interactivePlaygroundFocus && !editorTextFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+f6\\\",\\n        \\\"command\\\": \\\"databricks.sync.start\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+f7\\\",\\n        \\\"command\\\": \\\"databricks.sync.stop\\\"\\n    }\\n]\",\"platform\":3}","snippets":"{\"snippets\":{\"dbx.code-snippets\":\"{\\n\\t// Place your global snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and \\n\\t// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope \\n\\t// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is \\n\\t// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: \\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. \\n\\t// Placeholders with the same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"scope\\\": \\\"javascript,typescript\\\",\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n    \\\"Databricks Init File\\\": {\\n        \\\"prefix\\\": \\\"dbx\\\",\\n        \\\"body\\\": [\\n            \\\"# Databricks notebook source\\\",\\n            \\\"import pyspark.sql.functions as F\\\",\\n            \\\"import pyspark.sql.types as T\\\",\\n            \\\"\\\",\\n            \\\"\\\",\\n            \\\"# COMMAND ----------\\\",\\n            \\\"def main() -> None:\\\",\\n            \\\"    pass\\\",\\n            \\\"\\\",\\n            \\\"\\\",\\n            \\\"main()\\\",\\n        ]\\n    }\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"github.copilot-chat\",\"uuid\":\"7ec7d6e6-b89e-4cc5-a59b-d6c4d238246f\"},\"displayName\":\"GitHub Copilot Chat\",\"disabled\":true,\"applicationScoped\":true},{\"identifier\":{\"id\":\"charliermarsh.ruff\",\"uuid\":\"c2ca9b43-fa38-44fc-928e-5125970b9c00\"},\"displayName\":\"Ruff\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"databricks.databricks\",\"uuid\":\"4e20f34d-db3e-411d-9294-6aca28da3d4f\"},\"displayName\":\"Databricks\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"gruntfuggly.todo-tree\",\"uuid\":\"261cac81-cd7b-4555-bb41-0c2d2bcd3e70\"},\"displayName\":\"Todo Tree\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-azure-devops.azure-pipelines\",\"uuid\":\"7032281c-aa10-4e95-9049-46a8bd112af3\"},\"displayName\":\"Azure Pipelines\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-azuretools.vscode-azurefunctions\",\"uuid\":\"b3b6d55f-76f7-45dd-b1ec-6df13764db03\"},\"displayName\":\"Azure Functions\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-azuretools.vscode-azureresourcegroups\",\"uuid\":\"260e9ed1-160d-4f7e-807c-2eb076ba3846\"},\"displayName\":\"Azure Resources\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.debugpy\",\"uuid\":\"4bd5d2c9-9d65-401a-b0b2-7498d9f17615\"},\"displayName\":\"Python Debugger\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.python\",\"uuid\":\"f1f59ae4-9318-4f3c-a9b5-81b2eaa5f8a5\"},\"displayName\":\"Python\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.vscode-pylance\",\"uuid\":\"364d2426-116a-433a-a5d8-a5098dc3afbd\"},\"displayName\":\"Pylance\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-python.vscode-python-envs\",\"uuid\":\"b41d8e8a-b6d4-4202-8f07-7189bdda81be\"},\"displayName\":\"Python Environments\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-toolsai.jupyter\",\"uuid\":\"6c2f1801-1e7f-45b2-9b5c-7782f1e076e8\"},\"displayName\":\"J