    "editor.background": "#1d1d1d",
    "editor.gutter.background": "#1d1d1d",
    "players": [
      {
        "cursor": "#ffffff",
      },
    ],
  },
  "max_tabs": 6,
  // LSP SETTINGS ---------------------------------------------------------------------------
  "languages": {
    "Python": {
      "colorize_brackets": true,
      "indent_guides": { "enabled": false },
      "language_servers": [
        // use the default configuration.
        "ruff",
        "pyrefly",
        "!pyright",
        "!pylsp",
      ],
    },
    "HTML": {
      "format_on_save": "off",
    },
    "JavaScript": {
      "format_on_save": "off",
    },
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "path": "/Users/ian.martensen/.local/bin/pyrefly",
        "arguments": ["lsp"],
      },
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python",
        },
        "pyrefly": {
          "search_path": ["packages/pulse"],
          "project_includes": ["."],
          "project_excludes": ["**/__pycache__", "**/node_modules", "typings/__builtins__.pyi"],
          // "search_path": ["./typings"],
          "ignore_errors_in_generated_code": true,
          "site_package_path": ["./typings"],
          "infer_with_first_use": false,
          "enabled_ignores": ["type", "pyrefly", "pyright"],
          "python_version": "3.12.*",
        },
      },
    },
