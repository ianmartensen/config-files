// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  "debugger": {
    "button": false,
    "dock": "bottom",
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "diff_view_style": "split",
  "text_rendering_mode": "platform_default",
  "remove_trailing_whitespace_on_save": false,
  "vim": {
    "use_system_clipboard": "never",
  },
  "agent_buffer_font_size": 20.0,
  "agent_ui_font_size": 14.0,
  "disable_ai": true,
  "terminal": {
    "font_size": 17.0,
    "default_height": 9999,
    "default_width": 9999,
    "dock": "bottom",
    "copy_on_select": true,
    "blinking": "off",
    "line_height": "standard",
    "flexible": false,
    "minimum_contrast": 20,
  },
  "outline_panel": {
    "dock": "left",
    "git_status": true,
    "file_icons": true,
    "default_width": 800,
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enabled": false,
  },
  "tabs": {
    "show_diagnostics": "all",
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
  },
  "file_finder": {
    "modal_max_width": "full",
  },
  "search": {
    "center_on_match": true,
    "button": true,
  },
  "git": {
    "hunk_style": "staged_hollow",
    "blame": {
      "show_avatar": false,
    },
    "inline_blame": {
      "show_commit_summary": true,
      "enabled": false,
    },
  },
  "middle_click_paste": false,
  "inlay_hints": {
    "show_type_hints": false,
    "show_background": false,
    "enabled": false,
  },
  "selection_highlight": false,
  "always_treat_brackets_as_autoclosed": true,
  "use_autoclose": false,
  "indent_guides": {
    "enabled": false,
    // "background_coloring": "disabled",
    // "coloring": "fixed",
    // "active_line_width": 0,
    // "line_width": 0,
  },
  "preferred_line_length": 100,
  "show_wrap_guides": true,
  "minimap": {
    "max_width_columns": 80,
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "gutter": {
    "runnables": true,
  },
  "relative_line_numbers": "enabled",
  "line_indicator_format": "long",

  "vertical_scroll_margin": 8.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "minimum_contrast_for_highlights": 30.0,
  "rounded_selection": false,
  "current_line_highlight": "none",
  "unnecessary_code_fade": 0.75,
  "hide_mouse": "on_typing_and_action",
  "cursor_shape": "bar",
  // "hard_tabs": false,
  // "tab_size": 4,
  "cursor_blink": false,
  "ui_font_family": "Monaspace Neon",
  "ui_font_size": 20.0,
  "buffer_line_height": "standard",
  "buffer_font_weight": 400,
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // "line_ending": "enforce_crlf",
  "buffer_font_size": 18.0,
  "buffer_font_family": "Fira Code",
  // "buffer_font_family": "Monaspace Argon",
  // "buffer_font_family": "Monaspace Neon",

  // Fira Code
  "buffer_font_features": {
    "calt": true, // Ligatures enable/disable
    // "cv01": 2, // Alternate style - a
    "ligatures": false,
    "ss03": true, // Alternate style - &
    "ss05": true, // Alternate style - @
  },

  // Monaspace Argon
  // "buffer_font_features": {
  //   "calt": false, // Texture healing
  //   "cv01": 2, // Alternate style      => 0;             values: 1, 2, 3, 4
  //   "cv02": false, // Alternate style  => 1;             values: true / false
  //   "cv10": true, // Alternate style l => i;             values: true / false
  //   "cv11": false, // Alternate style  => j, f, r, t;    values: true / false
  //   "cv30": true, // Alternate height  => *;             values: true / false
  //   "cv31": true, // Alternate style   => *              values: true / false
  //   // "ss01": true, // set ==, !=, === ligatures
  //   // "ss02": true, // set ==, !=, === ligatures
  //   "cv32": false, // Alternate style * >=
  // },
  // Monaspace Neon
  // "buffer_font_features": {
  //   "calt": true, // Texture healing
  //   "cv01": 2, // Alternate style      => 0;             values: 1, 2, 3, 4
  //   "cv02": false, // Alternate style  => 1;             values: true / false
  //   "cv10": false, // Alternate style l => i;            values: true / false
  //   "cv11": false, // Alternate style  => j, f, r, t;    values: true / false
  //   "cv30": true, // Alternate height  => *;             values: true / false
  //   "cv31": true, // Alternate style   => *              values: true / false
  //   // "ss01": true, // set ==, !=, === ligatures
  //   // "ss02": true, // set ==, !=, === ligatures
  //   "cv32": false, // Alternate style * >=
  // },
  "theme": "VSCode Dark Modern",
  "restore_on_startup": "last_session",
  "auto_update": true,
  "base_keymap": "VSCode",
  "collaboration_panel": { "dock": "left", "button": false },
  "inline_code_actions": false,
  "title_bar": {
    "show_branch_status_icon": true,
    "show_sign_in": false,
    "show_menus": false,
    "show_branch_name": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_user_picture": false,
  },
  "scrollbar": { "show": "auto" },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "project_panel": {
    "button": true,
    "hide_root": true,
    "auto_fold_dirs": false,
    "indent_size": 25.0,
    "folder_icons": true,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "default_width": 800,
    "file_icons": true,
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "sort_by_path": false,
    "collapse_untracked_diff": false,
    "status_style": "icon",
    "default_width": 450,
  },
  "use_auto_surround": true,
  "active_pane_modifiers": { "inactive_opacity": 0.5 },
  "auto_signature_help": false,
  "autosave": "off",
  "close_on_file_delete": true,
  "hover_popover_delay": 250,
  "centered_layout": {
    "left_padding": 0.1,
    "right_padding": 0.1,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null, // same values as the `diagnostics_max_severity` from the editor settings
    },
  },
  //   // APPEARANCE ------------------------------------------------------------------------------
  "icon_theme": "Catppuccin Frappé",
  "wrap_guides": [100],
